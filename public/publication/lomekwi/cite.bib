
@article{geraads_late_2026,
	title = {The Late Pliocene to Early Pleistocene Lomekwi faunas, West Turkana, Kenya: systematics, paleoecology, and biochronology},
	volume = {754},
	issn = {1040-6182},
	url = {https://www.sciencedirect.com/science/article/pii/S1040618225004215},
	doi = {10.1016/j.quaint.2025.110078},
	shorttitle = {The Late Pliocene to Early Pleistocene Lomekwi faunas, West Turkana, Kenya},
	abstract = {We describe here the vertebrate fauna collected by the West Turkana Paleo Project at Lomekwi, a site best known for yielding the holotype of Kenyanthropus platyops and Lomekwian stone tools, and consisting of several collecting areas providing fossil samples ranging in age from about 3.6 to 2.2 Ma. Analysis of the newly recovered material, alongside a thorough revision of earlier collections, has led to the identification of 85 vertebrate taxa, which provide biochronological indications that help refine the site's chronology and shed light on the paleoenvironmental conditions prevailing during a critical period of early hominin diversification. The newly described fauna illustrates that during the time of Kenyanthropus, hominins shared their landscapes with a rich assemblage of vertebrates, including abundant megaherbivores, some 28 species of artiodactyls, diverse large and medium-size carnivores, and giant crocodiles as apex predators in the lakes and rivers of the Turkana region in the Pliocene. Among primates, the recurring association of Theropithecus with hominins is found at Lomekwi as it is elsewhere. Paleoenvironmental proxies from the Turkana region emphasize the complex and dynamic nature of the habitats that supported this rich biodiversity.},
	pages = {110078},
	journaltitle = {Quaternary International},
	shortjournal = {Quaternary International},
	author = {Geraads, Denis and Bobe, René and Püschel, Thomas A. and Ward, Carol V. and Plavcan, J. Michael and Manthi, Fredrick Kyalo},
	urldate = {2025-12-17},
	date = {2026-02-01},
	keywords = {Mammalia, East Africa, Hominin, Paleoenvironment},
	file = {ScienceDirect Full Text PDF:/Users/thomas/Zotero/storage/BL6XULXC/Geraads et al. - 2026 - The Late Pliocene to Early Pleistocene Lomekwi faunas, West Turkana, Kenya systematics, paleoecolog.pdf:application/pdf;ScienceDirect Snapshot:/Users/thomas/Zotero/storage/Q4GV4G88/S1040618225004215.html:text/html},
}
